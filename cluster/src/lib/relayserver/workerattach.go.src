package relayserver

import (
	"context"
	"crypto/sha256"
	"encoding/hex"
	"sync"
	"time"

	"google.golang.org/grpc"
	"google.golang.org/grpc/codes"
	"google.golang.org/grpc/credentials"
	"google.golang.org/grpc/peer"
	"google.golang.org/grpc/status"

	"github.com/wandering-compiler/platform/plugins/cluster/lib/workeradmit"
	"github.com/wandering-compiler/platform/plugins/cluster/workerpb"
)

// WorkerServer is the relay's WORKER-facing half: a different audience, a
// different credential, and therefore a different listener from the one the
// control plane manages this relay on.
//
// The control plane is one known peer whose certificate is pinned. Workers are
// a fleet that comes and goes, admitted by approval — so this side verifies
// that a client certificate was presented and then asks the registry, rather
// than checking it against anything.
type WorkerServer struct {
	workerpb.UnimplementedWorkerAttachServer

	Workers *workeradmit.Registry

	// Backends is where a worker's declared capacity and readiness land, so
	// scheduling can see them. Optional: nil means nothing records profiles,
	// which is the shape the admission-only tests use.
	Backends *Backends

	// PollInterval is how often a waiting worker re-checks whether it has been
	// approved. Approval is a human looking at a screen, so this is seconds
	// rather than milliseconds; it is a field so a test does not have to wait
	// at human speed.
	PollInterval time.Duration
}

// Attach admits, refuses, or parks a connecting worker, and holds the stream
// open for as long as the worker is available.
//
// The stream is bidirectional: the worker opens with an announcement and may
// keep talking, which is how it drains or reports itself unhealthy without
// dropping the tunnel its running work is travelling over.
func (s *WorkerServer) Attach(
	srv grpc.BidiStreamingServer[workerpb.WorkerMessage, workerpb.AttachEvent],
) error {
	ctx := srv.Context()
	fp, err := peerFingerprint(ctx)
	if err != nil {
		return err
	}

	first, err := srv.Recv()
	if err != nil {
		return err
	}
	req := first.GetAnnounce()
	if req == nil {
		// Refused rather than defaulted. A status before an announcement is
		// about a worker that has not said what it is, and inventing an empty
		// announcement would put a nameless machine on the approval screen.
		return status.Error(codes.InvalidArgument,
			"relay: the first message on an attach stream must be the announcement")
	}

	// One attachment, one generation. Every profile write below carries it, so
	// a reconnect that overtakes this stream's unwind is not erased by it.
	att := s.newAttachment(fp, req.GetSlots())
	defer att.close()
	// The worker's OWN answer, as of the announcement. Taken from the
	// announcement rather than waiting for a first status, so a machine that
	// came up already draining is never briefly counted as ready.
	att.setWorkerReady(req.GetReadiness() == workerpb.WorkerStatus_READY)

	// Everything the worker says after the announcement, for as long as it is
	// connected. Runs alongside the admission logic below rather than inside
	// it, because a worker may drain while it is still waiting to be approved
	// and the two conversations do not take turns.
	go att.readStatuses(srv)

	switch s.Workers.Offer(fp, req.GetName(), req.GetDeviceId()) {
	case workeradmit.Reject:
		// The message names the fingerprint on purpose. A denied machine's
		// operator is usually its owner, and "you were denied" without saying
		// WHICH identity was denied is unactionable — especially on a box that
		// has been reinstalled and is presenting a new key.
		return status.Errorf(codes.PermissionDenied,
			"relay: %s is denied; if that fingerprint is not the one you expect, "+
				"this machine minted a new identity and needs approving again", fp)

	case workeradmit.Admit:
		att.setAdmitted(true)
		if err := s.sendAdmitted(srv, req.GetSlots()); err != nil {
			return err
		}
		// And then HOLD. The stream is the worker's availability — the relay
		// knows it is there because this is open — so returning here would
		// close it, the worker would see EOF, report a disconnect and
		// reconnect, forever, in a loop that looks like a flapping network.
		return s.holdAdmitted(srv, fp)
	}

	// Waiting. The worker stays connected and does nothing, which is what puts
	// it on the operator's screen — a machine that hung up after being told to
	// wait would have to be caught mid-connection to be seen at all.
	if err := srv.Send(&workerpb.AttachEvent{
		Event: &workerpb.AttachEvent_Waiting{Waiting: &workerpb.Waiting{}},
	}); err != nil {
		return err
	}

	interval := s.PollInterval
	if interval <= 0 {
		interval = 5 * time.Second
	}
	tick := time.NewTicker(interval)
	defer tick.Stop()
	for {
		select {
		case <-ctx.Done():
			return status.FromContextError(ctx.Err()).Err()
		case <-tick.C:
			// Re-offered rather than only checked, so a decision that arrived
			// while this worker was parked also clears it from the pending
			// list — otherwise it would keep being reported as news.
			switch s.Workers.Offer(fp, req.GetName(), req.GetDeviceId()) {
			case workeradmit.Reject:
				return status.Errorf(codes.PermissionDenied, "relay: %s is denied", fp)
			case workeradmit.Admit:
				att.setAdmitted(true)
				if err := s.sendAdmitted(srv, req.GetSlots()); err != nil {
					return err
				}
				return s.holdAdmitted(srv, fp)
			}
		}
	}
}

// peerFingerprint reads the identity out of the TLS handshake.
//
// This is the only thing in the conversation the worker PROVED; everything in
// AttachReq is a claim. A missing certificate is refused rather than treated
// as an anonymous worker: the listener is supposed to require one, so its
// absence means the server was misconfigured, and admitting on a
// misconfiguration is how a whole fleet gets let in at once.
func peerFingerprint(ctx context.Context) (string, error) {
	p, ok := peer.FromContext(ctx)
	if !ok || p.AuthInfo == nil {
		return "", status.Error(codes.Unauthenticated,
			"relay: the worker listener accepted a connection with no TLS information — "+
				"it must require a client certificate")
	}
	tlsInfo, ok := p.AuthInfo.(credentials.TLSInfo)
	if !ok || len(tlsInfo.State.PeerCertificates) == 0 {
		return "", status.Error(codes.Unauthenticated,
			"relay: the worker presented no certificate, so it has no identity to approve")
	}
	sum := sha256.Sum256(tlsInfo.State.PeerCertificates[0].Raw)
	return hex.EncodeToString(sum[:]), nil
}

// attachment is one worker's stream, and the single place its two independent
// answers are combined.
//
// A worker contributes capacity only when BOTH are true: the operator admitted
// it, and it says it wants work. They arrive from different places and change
// independently — approval from a human on a screen, readiness from the
// machine — so neither can be folded into the other.
//
// Admission being part of it is not a detail. capacityLocked sums over
// profiles and knows nothing about approval, so a profile published before
// admission would make a PENDING worker raise the relay's capacity: callers
// would be granted tickets and then refused at the proxy, because take() does
// check admission. That is the same "a grant is not a slot" defect this whole
// change exists to remove, re-entering through the other door (caught in
// review on PR #9).
type attachment struct {
	b     *Backends
	fp    string
	gen   uint64
	slots uint32

	mu       sync.Mutex
	admitted bool
	ready    bool
}

func (s *WorkerServer) newAttachment(fp string, slots uint32) *attachment {
	a := &attachment{fp: fp, slots: slots}
	if s.Backends != nil {
		a.b = s.Backends
		a.gen = s.Backends.NewAttachment()
	}
	return a
}

func (a *attachment) setAdmitted(v bool) {
	a.mu.Lock()
	a.admitted = v
	a.mu.Unlock()
	a.publish()
}

func (a *attachment) setWorkerReady(v bool) {
	a.mu.Lock()
	a.ready = v
	a.mu.Unlock()
	a.publish()
}

func (a *attachment) publish() {
	if a.b == nil {
		return
	}
	a.mu.Lock()
	ready := a.admitted && a.ready
	a.mu.Unlock()
	a.b.SetProfile(a.fp, a.gen, a.slots, ready)
}

func (a *attachment) close() {
	if a.b != nil {
		a.b.ClearProfile(a.fp, a.gen)
	}
}

// readStatuses applies every status update until the stream ends.
//
// Errors end it silently: a failed Recv means the worker is gone, and the
// admission half owns reporting that. The deferred close on the way out of
// Attach is what stops the fleet counting a machine that stopped talking.
func (a *attachment) readStatuses(
	srv grpc.BidiStreamingServer[workerpb.WorkerMessage, workerpb.AttachEvent],
) {
	for {
		msg, err := srv.Recv()
		if err != nil {
			return
		}
		st := msg.GetStatus()
		if st == nil {
			// A second announcement, or an empty message. Ignored rather than
			// fatal: the identity is the certificate and cannot be re-declared,
			// so there is nothing here to act on and nothing worth killing a
			// live worker's stream over.
			continue
		}
		a.setWorkerReady(st.GetReadiness() == workerpb.WorkerStatus_READY)
	}
}

func (s *WorkerServer) sendAdmitted(
	srv grpc.BidiStreamingServer[workerpb.WorkerMessage, workerpb.AttachEvent],
	slots uint32,
) error {
	return srv.Send(&workerpb.AttachEvent{
		Event: &workerpb.AttachEvent_Admitted{Admitted: &workerpb.Admitted{Slots: slots}},
	})
}

// holdAdmitted keeps an admitted worker's stream open for as long as it stays
// admitted.
//
// Two jobs, and the second is the one that is easy to miss: the open stream IS
// the availability, and a decision can change while it is open. A worker
// denied mid-attachment has to be told, or it keeps its tunnel and keeps
// taking work until it next reconnects — which, for a healthy worker, is
// never.
func (s *WorkerServer) holdAdmitted(
	srv grpc.BidiStreamingServer[workerpb.WorkerMessage, workerpb.AttachEvent],
	fp string,
) error {
	ctx := srv.Context()
	interval := s.PollInterval
	if interval <= 0 {
		interval = 5 * time.Second
	}
	tick := time.NewTicker(interval)
	defer tick.Stop()
	for {
		select {
		case <-ctx.Done():
			return status.FromContextError(ctx.Err()).Err()
		case <-tick.C:
			if !s.Workers.Admitted(fp) {
				return status.Errorf(codes.PermissionDenied,
					"relay: %s is no longer admitted", fp)
			}
		}
	}
}
