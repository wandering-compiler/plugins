// Package gen is the cluster plugin author's compile-time contract with the
// bundle codegen — v4 plugin model. It holds the typed interfaces
// (EnvConfig, HandlerRegistry, ClientSet) the plugin's RegisterPlugin depends
// on, plus the protoc-generated bindings under pb/.
//
// At staging time the bundle's host codegen synthesises a parallel `gen/`
// package with the same exported types populated for the activation, and the
// staging import rewrite swaps `<go_module>/gen` for the per-activation staged
// path — so the authored code links against the codegen-emitted types with no
// text edits. The local gen/pb stubs are author-only (regenerated by
// `w17ctl plugin gen-pb`); the bundle uses its own per-activation pb.
//
// ⚠️ THIS FILE IS A CLAIM ABOUT CODE NOBODY HERE COMPILES. Everything in it
// has to match what the bundle emits, and nothing in this module checks that:
// `go build` here passes against these declarations, and a consumer's build is
// the first thing that ever compares them. The agent plugin shipped unusable
// exactly this way — its author-side RegisterPlugin took two arguments while
// the bundle-side wiring called three.
//
// So: when this file changes, the verification is a CONSUMER BUILD, not a
// green build in this module.
package gen

import (
	"context"

	pb "github.com/wandering-compiler/platform/plugins/cluster/gen/pb"
)

// EnvConfig is the plugin's typed configuration, one field per `env:` entry in
// plugin.yaml.
//
// No field here is secret.String, and that is deliberate: the two credential
// entries are PATHS. A filename is not a secret, the file is — so the key
// never enters the environment at all, which is a stronger position than
// wrapping its name in a type.
type EnvConfig struct {
	// ClientCertPath is the PEM client certificate this control plane presents
	// to a relay. One identity for every relay; the per-relay half of the
	// trust decision is the pinned fingerprint on the row.
	ClientCertPath string

	// ClientKeyPath is the private key for ClientCertPath.
	ClientKeyPath string

	// DialTimeoutSeconds bounds opening one management connection. Short on
	// purpose: an unreachable relay must be skipped fast enough that
	// scheduling falls through to a healthy one.
	DialTimeoutSeconds int

	// TicketTtlSeconds is advisory here — the RELAY mints tickets and decides
	// how long they stay claimable. Carried so a deployment can state its
	// intent in one place; a relay that disagrees wins, because it is the one
	// holding the slot.
	//
	// `Ttl` and not `TTL`: the codegen upper-cases a SMALL set of initialisms
	// whole (`api`, `url`, `id`, `http`, …) when it turns a manifest name into
	// a Go field, and `ttl` is not in it. The bundle references the name IT
	// produces, so this one is not a style choice.
	TicketTtlSeconds int
}

// HandlerRegistry is how the plugin hands its server implementation to the
// bundle.
type HandlerRegistry interface {
	RegisterClusterServiceServer(impl pb.ClusterServiceServer)
	RegisterShutdown(fn func(ctx context.Context) error)
}

// ClientSet is the bundle's typed in-process clients for this plugin's own
// tables. The handlers reach their registry through these rather than through
// SQL, so the plugin never assumes a dialect or a connection.
type ClientSet interface {
	RelayQuery() pb.RelayQueryClient
	RelayMutation() pb.RelayMutationClient
	WorkerQuery() pb.WorkerQueryClient
	WorkerMutation() pb.WorkerMutationClient
}
